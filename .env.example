# ==============================================================================
# Configurações do Software de Chat & Atendimento (Cliente)
# ==============================================================================

# Portas de Exposição
WEB_PORT=80
API_PORT=8080
DB_PORT=5432

# Banco de Dados PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=solcrm

# Segredo JWT para geração de tokens de operadores
JWT_SECRET=sol-crm-master-secret-key-2026-production

# URL do Super Servidor Master de Licenças (Control Plane)
# Exemplo em produção: https://master.provedor.com.br:8090
MASTER_LICENSE_SERVER_URL=http://localhost:8090

# Identificação da Instalação do Cliente (Para Auto-Registro no Master)
TENANT_NAME=Sol Telecom
TENANT_CNPJ=12.345.678/0001-90
SERVER_PUBLIC_URL=http://chat.soltelecom.com.br

# Origens permitidas para requisições CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:8080
