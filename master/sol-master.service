[Unit]
Description=SOL Telecom - Master License Control Plane
After=network.target

[Service]
Type=simple
User=solmaster
Group=solmaster
WorkingDirectory=/opt/sol-master
ExecStart=/opt/sol-master/master
Restart=always
RestartSec=5
EnvironmentFile=-/opt/sol-master/.env
Environment=PORT=8090
Environment=DATA_FILE_PATH=/opt/sol-master/data/master_licenses.json
Environment=MASTER_JWT_SECRET=sol-master-ultra-secure-key-2026
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
